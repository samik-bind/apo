---
/**
 * MobileMenuFooter override — Starlight's default renders SocialIcons +
 * ThemeSelect + LanguageSelect here. ThemeSelect is dropped: docs are
 * dark-only (design.md), and the site is single-language, so LanguageSelect
 * renders nothing either. Only the social icons remain.
 */
import SocialIcons from "virtual:starlight/components/SocialIcons";
---

<div class="mobile-preferences sl-flex">
	<div class="social-icons">
		<SocialIcons />
	</div>
</div>

<style>
	@layer starlight.core {
		.social-icons {
			display: flex;
			margin-inline-end: auto;
			gap: 1rem;
			align-items: center;
			padding-block: 1rem;
		}
		.social-icons:empty {
			display: none;
		}
		.mobile-preferences {
			justify-content: space-between;
			flex-wrap: wrap;
			border-top: 1px solid var(--sl-color-gray-6);
			column-gap: 1rem;
			padding: 0.5rem 0;
		}
	}
</style>
